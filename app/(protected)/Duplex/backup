                    )
                  })}
                </select>
                {formErrors.sheet_size_id && (
                  <p className="text-xs text-red-600 mt-2">{formErrors.sheet_size_id}</p>
                )}
              </div>
            )}
          </div>

          {/* Harga */}
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Harga per Lembar *
            </label>
            <div className="relative">
              <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span className="text-gray-500">Rp</span>
              </div>
              <input
                type="number"
                value={addFormData.harga_per_lembar}
                onChange={(e) => handleAddInputChange('harga_per_lembar', e.target.value)}
                placeholder="10000"
                min="1"
                step="100"
                disabled={isPosting}
                className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-700"
              />
            </div>
            {formErrors.harga_per_lembar && (
              <p className="text-xs text-red-600 mt-2">{formErrors.harga_per_lembar}</p>
            )}
          </div>

          {/* Preview Section */}
          {selectedSize && selectedGramasi && (
            <div className="bg-green-50 p-4 rounded-lg border border-green-200">
              <h4 className="font-medium text-green-900 mb-3 flex items-center gap-2">
                <Icon icon="mdi:check-circle" className="w-4 h-4" />
                Preview Data yang Akan Ditambahkan ke Tab {activeTab}
              </h4>
              <div className="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <p className="text-gray-600">Ukuran:</p>
                  <p className="font-medium text-gray-900">
                    {formatUkuranDisplay(
                      parsePL(formatPLFromSheet(selectedSize.panjang_sh, selectedSize.lebar_sh)).panjang,
                      parsePL(formatPLFromSheet(selectedSize.panjang_sh, selectedSize.lebar_sh)).lebar
                    )}
                  </p>
                </div>
                <div>
                  <p className="text-gray-600">GSM:</p>
                  <p className="font-medium text-gray-900">{selectedGramasi.gsm} GSM</p>
                </div>
                <div>
                  <p className="text-gray-600">PL Format:</p>
                  <p className="font-mono text-gray-900">{formatPLFromSheet(selectedSize.panjang_sh, selectedSize.lebar_sh)}</p>
                </div>
                <div>
                  <p className="text-gray-600">Harga:</p>
                  <p className="font-medium text-gray-900">Rp {parseInt(addFormData.harga_per_lembar || '0').toLocaleString('id-ID')}</p>
                </div>
              </div>
              
              <div className="mt-3 p-2 bg-blue-50 rounded border border-blue-200">
                <p className="text-xs font-medium text-blue-900 mb-1">📤 Format yang dikirim ke backend:</p>
                <p className="text-xs text-blue-800 font-mono">
                  {JSON.stringify({
                    gramasi: addFormData.gramasi_id,
                    pl: addFormData.sheet_size_id,
                    harga_per_lembar: addFormData.harga_per_lembar
                  }, null, 2)}
                </p>
              </div>
            </div>
          )}

          {formErrors.general && (
            <div className="bg-red-50 border border-red-200 rounded-lg p-4">
              <div className="flex items-center gap-2">
                <Icon icon="mdi:alert-circle" className="w-5 h-5 text-red-600" />
                <p className="text-red-800">{formErrors.general}</p>
              </div>
            </div>
          )}
        </div>
      </Modal>

      {/* Edit Modal */}
      <Modal
        isOpen={showEditModal}
        onClose={handleCloseEditModal}
        title={`Edit Ukuran Duplex ${editingItem?.type}`}
        size="lg"
        footer={
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={handleCloseEditModal} disabled={isPosting}>
              Batal
            </Button>
            <Button
              variant="primary"
              onClick={handleEditSave}
              loading={isPosting}
              disabled={isPosting}
            >
              {isPosting ? 'Menyimpan...' : 'Simpan'}
            </Button>
          </div>
        }
      >
        {editingItem && (
          <div className="space-y-6">
            {/* Info Section */}
            <div className="p-4 bg-blue-50 rounded-lg border border-blue-200">
              <div className="flex items-center justify-between mb-3">
                <div>
                  <p className="text-sm text-gray-600">ID Record:</p>
                  <p className="font-medium font-mono text-gray-700">#{editingItem.id}</p>
                </div>
                <Badge variant={editingItem.type === 'DK' ? 'primary' : 'secondary'}>
                  {editingItem.type}
                </Badge>
              </div>
              
              <div className="grid grid-cols-2 gap-3 text-sm mt-2">
                <div>
                  <p className="text-gray-600">Current Ukuran:</p>
                  <p className="font-medium text-gray-900">
                    {editingItem.pl ? 
                      `${formatUkuranDisplay(editingItem.panjang, editingItem.lebar)}` : 
                      `${editingItem.panjang}×${editingItem.lebar} cm`
                    }
                  </p>
                </div>
                <div>
                  <p className="text-gray-600">Current GSM:</p>
                  <p className="font-medium text-gray-900">{editingItem.gsm} GSM</p>
                </div>
                <div>
                  <p className="text-gray-600">Current Harga:</p>
                  <p className="font-medium text-gray-900">{formatCurrency(editingItem.harga_per_lembar)}</p>
                </div>
              </div>
            </div>

            {/* Sheet Size Selection */}
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Ukuran Baru * 
              </label>
              <select
                value={editFormData.sheet_size_id}
                onChange={(e) => handleEditInputChange('sheet_size_id', e.target.value)}
                disabled={isPosting}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-700"
              >
                <option value="">Pilih Ukuran</option>
                {sheetSizeList.map((item) => {
                  const plValue = formatPLFromSheet(item.panjang_sh, item.lebar_sh)
                  const { panjang, lebar } = parsePL(plValue)
                  return (
                    <option key={item.id_sh} value={item.id_sh}>
                      {formatUkuranDisplay(panjang, lebar)} ({plValue} mm)
                    </option>
                  )
                })}
              </select>
              {formErrors.sheet_size_id && (
                <p className="text-xs text-red-600 mt-2">{formErrors.sheet_size_id}</p>
              )}
            </div>

            {/* GSM Selection */}
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                GSM Baru *
              </label>
              <select
                value={editFormData.gramasi_id}
                onChange={(e) => handleEditInputChange('gramasi_id', e.target.value)}
                disabled={isPosting}
                className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-700"
              >
                <option value="">Pilih GSM</option>
                {gramasiList.map((item) => (
                  <option key={item.id} value={item.id}>
                    {item.gsm} GSM
                  </option>
                ))}
              </select>
              {formErrors.gramasi_id && (
                <p className="text-xs text-red-600 mt-2">{formErrors.gramasi_id}</p>
              )}
            </div>

            {/* Harga */}
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-2">
                Harga per Lembar Baru *
              </label>
              <div className="relative">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <span className="text-gray-500">Rp</span>
                </div>
                <input
                  type="number"
                  value={editFormData.harga_per_lembar}
                  onChange={(e) => handleEditInputChange('harga_per_lembar', e.target.value)}
                  placeholder="10000"
                  min="1"
                  step="100"
                  disabled={isPosting}
                  className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-700"
                />
              </div>
              {formErrors.harga_per_lembar && (
                <p className="text-xs text-red-600 mt-2">{formErrors.harga_per_lembar}</p>
              )}
            </div>

            {/* Preview Edit Selection */}
            {editSelectedSize && editSelectedGramasi && (
              <div className="bg-green-50 p-4 rounded-lg border border-green-200">
                <h4 className="font-medium text-green-900 mb-3 flex items-center gap-2">
                  <Icon icon="mdi:check-circle" className="w-4 h-4" />
                  Preview Data yang Akan Diupdate
                </h4>
                <div className="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <p className="text-gray-600">Ukuran Baru:</p>
                    <p className="font-medium text-gray-900">
                      {formatUkuranDisplay(
                        parsePL(formatPLFromSheet(editSelectedSize.panjang_sh, editSelectedSize.lebar_sh)).panjang,
                        parsePL(formatPLFromSheet(editSelectedSize.panjang_sh, editSelectedSize.lebar_sh)).lebar
                      )}
                    </p>
                  </div>
                  <div>
                    <p className="text-gray-600">GSM Baru:</p>
                    <p className="font-medium text-gray-900">{editSelectedGramasi.gsm} GSM</p>
                  </div>
                  <div>
                    <p className="text-gray-600">PL Format:</p>
                    <p className="font-mono text-gray-900">{formatPLFromSheet(editSelectedSize.panjang_sh, editSelectedSize.lebar_sh)}</p>
                  </div>
                  <div>
                    <p className="text-gray-600">Harga Baru:</p>
                    <p className="font-medium text-gray-900">Rp {parseInt(editFormData.harga_per_lembar || '0').toLocaleString('id-ID')}</p>
                  </div>
                </div>
                
                <div className="mt-3 p-2 bg-blue-50 rounded border border-blue-200">
                  <p className="text-xs font-medium text-blue-900 mb-1">📤 Format yang dikirim ke backend:</p>
                  <p className="text-xs text-blue-800 font-mono">
                    {JSON.stringify({
                      gramasi: editFormData.gramasi_id,
                      pl: editFormData.sheet_size_id,
                      harga_per_lembar: editFormData.harga_per_lembar
                    }, null, 2)}
                  </p>
                </div>
              </div>
            )}
          </div>
        )}
      </Modal>
    </div>
  )
}