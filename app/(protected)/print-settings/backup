// app/(protected)/print-settings/page.tsx

'use client'

import { useState, useEffect } from 'react'
import Card from '@/components/UI/Card'
import Button from '@/components/UI/Button'
import Badge from '@/components/UI/Badge'
import Input from '@/components/UI/Input'
import Modal from '@/components/UI/Modal'
import { Icon } from '@iconify/react'
import Swal from 'sweetalert2'
import { Table, TableRow, TableCell } from '@/components/UI/Table'
import axiosInstance from '@/lib/axios'

// Types
interface Machine {
  id_ma: string
  name_ma: string
  bahan_max_panjang: string
  bahan_max_lebar: string
  bahan_min_panjang: string
  bahan_min_lebar: string
  cetak_max_panjang: string
  cetak_max_lebar: string
  cetak_min_panjang: string
  cetak_min_lebar: string
  harga_blok: string
  harga_tulisan: string
  harga_separasi: string
}

interface ApiResponse {
  status: number
  message: string
  data: Machine[]
}

interface Stats {
  totalMachines: number
  activeMachines: number
  pm52Count: number
  sm74Count: number
  planoMaxCount: number
  priceRange: {
    min: number
    max: number
  }
}

const printTypes = [
  { id: 'blok', label: 'Cetak Blok', field: 'harga_blok', icon: 'mdi:layers' },
  { id: 'tulisan', label: 'Cetak Tulisan', field: 'harga_tulisan', icon: 'mdi:format-text' },
  { id: 'separasi', label: 'Cetak Separasi', field: 'harga_separasi', icon: 'mdi:palette' }
]

type ViewMode = 'card' | 'list'

export default function PrintSettingsPage() {
  const [machines, setMachines] = useState<Machine[]>([])
  const [loading, setLoading] = useState(true)
  const [posting, setPosting] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [search, setSearch] = useState('')
  const [viewMode, setViewMode] = useState<ViewMode>('card')
  const [selectedMachine, setSelectedMachine] = useState<Machine | null>(null)
  const [isViewModalOpen, setIsViewModalOpen] = useState(false)
  const [isEditModalOpen, setIsEditModalOpen] = useState(false)

  // Stats
  const [stats, setStats] = useState<Stats>({
    totalMachines: 0,
    activeMachines: 0,
    pm52Count: 0,
    sm74Count: 0,
    planoMaxCount: 0,
    priceRange: {
      min: 0,
      max: 0
    }
  })

  // Fetch data from API
  useEffect(() => {
    fetchMachines()
  }, [])

  const fetchMachines = async () => {
    try {
      setLoading(true)
      setError(null)
      
      const response = await axiosInstance.get<ApiResponse>('Admin/Cetak/Machine', {
        headers: {
          'ngrok-skip-browser-warning': 'true'
        },
        timeout: 10000
      })
      
      if (response.data?.status === 200 && Array.isArray(response.data.data)) {
        setMachines(response.data.data)
        calculateStats(response.data.data)
      } else if (response.data?.status === 200 && (!response.data.data || response.data.data.length === 0)) {
        setMachines([])
        resetStats()
      } else {
        setMachines([])
        resetStats()
      }
      
    } catch (err: any) {
      console.error('❌ Error fetching machines:', err)
      
      if (err.response?.status === 404 || err.response?.status === 204) {
        setMachines([])
        resetStats()
        setError(null)
      } else if (err.code === 'ECONNABORTED') {
        setError('Koneksi timeout. Silakan coba lagi.')
      } else if (!err.response) {
        setError('Tidak bisa connect ke server. Periksa koneksi internet.')
      } else {
        setError(err.response?.data?.message || 'Terjadi kesalahan saat memuat data')
      }
    } finally {
      setLoading(false)
    }
  }

  const calculateStats = (machineData: Machine[]) => {
    const totalMachines = machineData.length
    const activeMachines = machineData.length
    
    // Count machines by name from API data
    const pm52Count = machineData.filter(m => m.name_ma?.toUpperCase() === 'PM52').length
    const sm74Count = machineData.filter(m => m.name_ma?.toUpperCase() === 'SM74').length
    const planoMaxCount = machineData.filter(m => 
      m.name_ma?.toUpperCase().includes('PLANO') || 
      m.name_ma?.toUpperCase().includes('PLANO MAX')
    ).length
    
    // Calculate price range
    const allPrices = machineData.flatMap(m => [
      parseFloat(m.harga_blok),
      parseFloat(m.harga_tulisan),
      parseFloat(m.harga_separasi)
    ]).filter(price => !isNaN(price) && price > 0)
    
    const priceRange = {
      min: allPrices.length > 0 ? Math.min(...allPrices) : 0,
      max: allPrices.length > 0 ? Math.max(...allPrices) : 0
    }
    
    setStats({
      totalMachines,
      activeMachines,
      pm52Count,
      sm74Count,
      planoMaxCount,
      priceRange
    })
  }

  const resetStats = () => {
    setStats({
      totalMachines: 0,
      activeMachines: 0,
      pm52Count: 0,
      sm74Count: 0,
      planoMaxCount: 0,
      priceRange: { min: 0, max: 0 }
    })
  }

  const filteredMachines = machines.filter(machine => {
    const matchesSearch = 
      machine.name_ma.toLowerCase().includes(search.toLowerCase()) ||
      machine.id_ma.includes(search)
    return matchesSearch
  })

  const formatCurrency = (amount: string | number) => {
    const num = typeof amount === 'string' ? parseFloat(amount) : amount
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(num)
  }

  const formatSize = (panjang: string, lebar: string) => {
    return `${parseFloat(panjang).toFixed(1)} × ${parseFloat(lebar).toFixed(1)} cm`
  }

  const handleRefresh = async () => {
    const result = await Swal.fire({
      title: 'Refresh Data?',
      text: 'This will reload data from the server.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#1f4390',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Ya, Refresh!',
      cancelButtonText: 'Batal',
      reverseButtons: true
    })
    
    if (result.isConfirmed) {
      await fetchMachines()
    }
  }

  const handleViewDetails = (machine: Machine) => {
    setSelectedMachine(machine)
    setIsViewModalOpen(true)
  }

  const handleEdit = (machine: Machine) => {
    setSelectedMachine(machine)
    setIsViewModalOpen(false)
    setIsEditModalOpen(true)
  }

  const handleUpdate = async (formData: any) => {
    if (!selectedMachine) return
    
    try {
      setPosting(true)
      
      const updateData = {
        id_ma: selectedMachine.id_ma,
        name_ma: selectedMachine.name_ma,
        bahan_max_panjang: formData.maxMaterialWidth.toString(),
        bahan_max_lebar: formData.maxMaterialLength.toString(),
        bahan_min_panjang: formData.minMaterialWidth.toString(),
        bahan_min_lebar: formData.minMaterialLength.toString(),
        cetak_max_panjang: formData.maxPrintWidth.toString(),
        cetak_max_lebar: formData.maxPrintLength.toString(),
        cetak_min_panjang: formData.minPrintWidth.toString(),
        cetak_min_lebar: formData.minPrintLength.toString(),
        harga_blok: formData.priceBlok.toString(),
        harga_tulisan: formData.priceTulisan.toString(),
        harga_separasi: formData.priceSeparasi.toString()
      }

      // TODO: Uncomment when API is ready
      // const response = await axiosInstance.put(`Admin/Cetak/Machine/${selectedMachine.id_ma}`, updateData)
      
      await Swal.fire({
        icon: 'success',
        title: 'Berhasil!',
        text: 'Machine settings updated successfully!',
        showConfirmButton: false,
        timer: 1500
      })
      
      setIsEditModalOpen(false)
      setSelectedMachine(null)
      await fetchMachines()
      
    } catch (error) {
      console.error('Error updating:', error)
      Swal.fire({
        icon: 'error',
        title: 'Error!',
        text: 'Failed to update machine settings',
        confirmButtonColor: '#1f4390',
      })
    } finally {
      setPosting(false)
    }
  }

  const handleCloseModal = () => {
    if (!posting) {
      setIsViewModalOpen(false)
      setIsEditModalOpen(false)
      setSelectedMachine(null)
    }
  }

  // Loading State
  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[400px]">
        <div className="text-center">
          <Icon icon="svg-spinners:ring-resize" className="w-12 h-12 text-blue-600 animate-spin mx-auto mb-4" />
          <p className="text-gray-600">Memuat data machines...</p>
        </div>
      </div>
    )
  }

  // Error State
  if (error) {
    return (
      <div className="space-y-6 p-4 md:p-6">
        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
          <div>
            <h1 className="text-2xl md:text-3xl font-bold text-gray-900">
              Print Settings
            </h1>
            <p className="text-gray-600 mt-1">Kelola konfigurasi mesin cetak</p>
          </div>
        </div>
        
        <Card className="border-red-200 bg-red-50">
          <div className="flex items-center gap-3 p-4">
            <Icon icon="mdi:alert-circle" className="w-6 h-6 text-red-600 flex-shrink-0" />
            <div>
              <h3 className="text-lg font-medium text-red-800">Error Loading Data</h3>
              <p className="text-red-700 mt-1">{error}</p>
              <Button
                onClick={fetchMachines}
                variant="danger"
                className="mt-4"
                icon="mdi:refresh"
              >
                Coba Lagi
              </Button>
            </div>
          </div>
        </Card>
      </div>
    )
  }

  // Main UI
  return (
    <div className="space-y-6 p-4 md:p-6">
      {/* Header */}
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <div>
          <h1 className="text-2xl md:text-3xl font-bold text-gray-900">
            Print Settings
          </h1>
          <p className="text-gray-600 mt-1">Kelola konfigurasi mesin cetak dan harga</p>
        </div>
        
        <Button
          onClick={handleRefresh}
          variant="primary"
          icon="mdi:refresh"
          className="w-full md:w-auto"
        >
          Refresh
        </Button>
      </div>

      {/* Stats Cards - Dynamic from API */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
        <Card className="bg-white hover:shadow-lg transition-shadow duration-200">
          <div className="space-y-2">
            <p className="text-sm text-gray-600 flex items-center gap-2">
              <Icon icon="mdi:printer-multiple" className="w-4 h-4 text-blue-600" />
              Total Machines
            </p>
            <div className="flex items-baseline gap-2">
              <p className="text-2xl font-bold text-gray-900">{stats.totalMachines}</p>
              <span className="text-sm text-blue-600 font-medium flex items-center">
                <Icon icon="mdi:cog" className="w-4 h-4 mr-1" />
                active
              </span>
            </div>
            <p className="text-xs text-gray-500">mesin terkonfigurasi</p>
          </div>
        </Card>

        <Card className="bg-white hover:shadow-lg transition-shadow duration-200">
          <div className="space-y-2">
            <p className="text-sm text-gray-600 flex items-center gap-2">
              <Icon icon="mdi:printer-outline" className="w-4 h-4 text-amber-600" />
              PM52
            </p>
            <div className="flex items-baseline gap-2">
              <p className="text-2xl font-bold text-gray-900">{stats.pm52Count}</p>
            </div>
            <p className="text-xs text-gray-500">Max: 37×52 cm</p>
          </div>
        </Card>

        <Card className="bg-white hover:shadow-lg transition-shadow duration-200">
          <div className="space-y-2">
            <p className="text-sm text-gray-600 flex items-center gap-2">
              <Icon icon="mdi:printer-outline" className="w-4 h-4 text-green-600" />
              SM74
            </p>
            <div className="flex items-baseline gap-2">
              <p className="text-2xl font-bold text-gray-900">{stats.sm74Count}</p>
            </div>
            <p className="text-xs text-gray-500">Max: 52.5×72 cm</p>
          </div>
        </Card>

        <Card className="bg-white hover:shadow-lg transition-shadow duration-200">
          <div className="space-y-2">
            <p className="text-sm text-gray-600 flex items-center gap-2">
              <Icon icon="mdi:printer-outline" className="w-4 h-4 text-indigo-600" />
              Plano Max
            </p>
            <div className="flex items-baseline gap-2">
              <p className="text-2xl font-bold text-gray-900">{stats.planoMaxCount}</p>
            </div>
            <p className="text-xs text-gray-500">Max: 72×102 cm</p>
          </div>
        </Card>

        <Card className="bg-white hover:shadow-lg transition-shadow duration-200">
          <div className="space-y-2">
            <p className="text-sm text-gray-600 flex items-center gap-2">
              <Icon icon="mdi:cash-multiple" className="w-4 h-4 text-purple-600" />
              Price Range
            </p>
            <div className="flex flex-col">
              <p className="text-lg font-bold text-gray-900">
                {formatCurrency(stats.priceRange.min)}
              </p>
              <p className="text-xs text-gray-600">
                to {formatCurrency(stats.priceRange.max)}
              </p>
            </div>
            <p className="text-xs text-gray-500">per print type</p>
          </div>
        </Card>
      </div>

      {/* Search and View Toggle */}
      <Card>
        <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
          <div>
            <h3 className="text-lg font-semibold text-gray-900 flex items-center gap-2">
              <Icon icon="mdi:clipboard-list-outline" className="w-5 h-5 text-blue-600" />
              All Machines
            </h3>
            <p className="text-sm text-gray-600 mt-1">
              {stats.totalMachines} machines terdaftar
            </p>
          </div>
          
          <div className="flex gap-2 w-full sm:w-auto items-center">
            <div className="relative flex-1 sm:w-64">
              <Input
                leftIcon="mdi:magnify"
                placeholder="Search machines..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="pl-10"
              />
              {search && (
                <button
                  onClick={() => setSearch('')}
                  className="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600"
                >
                  <Icon icon="mdi:close-circle" className="w-5 h-5" />
                </button>
              )}
            </div>

            {/* View Toggle */}
            <div className="flex bg-gray-100 rounded-lg p-1">
              <button
                onClick={() => setViewMode('card')}
                className={`px-3 py-2 rounded-md transition-all ${
                  viewMode === 'card'
                    ? 'bg-white text-gray-900 shadow-sm'
                    : 'text-gray-600 hover:text-gray-900'
                }`}
                title="Card View"
              >
                <Icon icon="mdi:view-grid" className="w-5 h-5" />
              </button>
              <button
                onClick={() => setViewMode('list')}
                className={`px-3 py-2 rounded-md transition-all ${
                  viewMode === 'list'
                    ? 'bg-white text-gray-900 shadow-sm'
                    : 'text-gray-600 hover:text-gray-900'
                }`}
                title="List View"
              >
                <Icon icon="mdi:view-list" className="w-5 h-5" />
              </button>
            </div>
          </div>
        </div>

        {/* Card View */}
        {viewMode === 'card' && (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {filteredMachines.map((machine) => (
              <div
                key={machine.id_ma}
                className="group bg-gradient-to-br from-white to-gray-50 border border-gray-200 rounded-xl p-5 hover:shadow-xl transition-all hover:border-blue-300"
              >
                {/* Machine Header */}
                <div className="flex items-start justify-between mb-4">
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-blue-100 rounded-lg group-hover:bg-blue-600 transition-colors">
                      <Icon 
                        icon="mdi:printer" 
                        className="w-6 h-6 text-blue-600 group-hover:text-white transition-colors" 
                      />
                    </div>
                    <div>
                      <h4 className="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                        {machine.name_ma}
                      </h4>
                      <p className="text-xs text-gray-500">ID: {machine.id_ma}</p>
                    </div>
                  </div>
                  <Badge variant="success" size="sm" className="bg-green-100 text-green-700">
                    Active
                  </Badge>
                </div>

                {/* Size Information */}
                <div className="grid grid-cols-2 gap-3 mb-4">
                  <div className="bg-gray-50 rounded-lg p-2">
                    <p className="text-xs text-gray-500 mb-1">Material Max</p>
                    <p className="text-sm font-semibold text-gray-900">
                      {formatSize(machine.bahan_max_panjang, machine.bahan_max_lebar)}
                    </p>
                  </div>
                  <div className="bg-gray-50 rounded-lg p-2">
                    <p className="text-xs text-gray-500 mb-1">Print Max</p>
                    <p className="text-sm font-semibold text-gray-900">
                      {formatSize(machine.cetak_max_panjang, machine.cetak_max_lebar)}
                    </p>
                  </div>
                </div>

                {/* Price List */}
                <div className="space-y-2 mb-4">
                  {printTypes.map((type) => (
                    <div key={type.id} className="flex justify-between items-center text-sm">
                      <span className="text-gray-600 flex items-center gap-1">
                        <Icon icon={type.icon} className="w-4 h-4" />
                        {type.label}
                      </span>
                      <span className="font-bold text-green-600">
                        {formatCurrency(machine[type.field as keyof Machine])}
                      </span>
                    </div>
                  ))}
                </div>

                {/* Action Buttons */}
                <div className="pt-3 border-t border-gray-100 flex gap-2">
                  <Button
                    size="sm"
                    variant="outline"
                    onClick={() => handleViewDetails(machine)}
                    className="flex-1"
                  >
                    <Icon icon="mdi:eye" className="w-4 h-4 mr-1" />
                    View
                  </Button>
                  <Button
                    size="sm"
                    variant="primary"
                    onClick={() => handleEdit(machine)}
                    className="flex-1"
                  >
                    <Icon icon="mdi:pencil" className="w-4 h-4 mr-1" />
                    Edit
                  </Button>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* List View */}
        {viewMode === 'list' && (
          <Table
            headers={['Machine', 'Specifications', 'Pricing', 'Status', 'Actions']}
            striped
            hoverable
            className="mb-4"
          >
            {filteredMachines.map((machine) => (
              <TableRow key={machine.id_ma} hoverable>
                <TableCell>
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-blue-100 rounded-lg">
                      <Icon icon="mdi:printer" className="w-5 h-5 text-blue-600" />
                    </div>
                    <div>
                      <div className="font-bold text-gray-900">{machine.name_ma}</div>
                      <div className="text-xs text-gray-500">ID: {machine.id_ma}</div>
                    </div>
                  </div>
                </TableCell>
                <TableCell>
                  <div className="space-y-1 text-sm">
                    <div>
                      <span className="text-gray-600">Material: </span>
                      <span className="font-medium text-gray-900">
                        {formatSize(machine.bahan_max_panjang, machine.bahan_max_lebar)}
                      </span>
                    </div>
                    <div>
                      <span className="text-gray-600">Print: </span>
                      <span className="font-medium text-gray-900">
                        {formatSize(machine.cetak_max_panjang, machine.cetak_max_lebar)}
                      </span>
                    </div>
                  </div>
                </TableCell>
                <TableCell>
                  <div className="space-y-1 text-xs">
                    {printTypes.map((type) => (
                      <div key={type.id} className="flex items-center gap-2">
                        <Icon icon={type.icon} className="w-3 h-3 text-gray-400" />
                        <span className="font-bold text-green-600">
                          {formatCurrency(machine[type.field as keyof Machine])}
                        </span>
                      </div>
                    ))}
                  </div>
                </TableCell>
                <TableCell>
                  <Badge variant="success" size="sm">Active</Badge>
                </TableCell>
                <TableCell>
                  <div className="flex space-x-2">
                    <Button
                      size="xs"
                      variant="ghost"
                      onClick={() => handleViewDetails(machine)}
                      className="text-blue-600 hover:text-blue-700 hover:bg-blue-50"
                    >
                      <Icon icon="mdi:eye" className="w-4 h-4 mr-1" />
                      View
                    </Button>
                    
                    <Button
                      size="xs"
                      variant="ghost"
                      onClick={() => handleEdit(machine)}
                      className="text-amber-600 hover:text-amber-700 hover:bg-amber-50"
                    >
                      <Icon icon="mdi:pencil" className="w-4 h-4 mr-1" />
                      Edit
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </Table>
        )}

        {/* Empty State */}
        {filteredMachines.length === 0 && (
          <div className="text-center py-12">
            <Icon icon="mdi:printer-off" className="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <p className="text-gray-500 mb-2">Tidak ada machine yang ditemukan</p>
            <p className="text-sm text-gray-400 mb-6">Coba ubah kata kunci pencarian</p>
            <Button
              variant="outline"
              onClick={() => setSearch('')}
              icon="mdi:close"
            >
              Clear Search
            </Button>
          </div>
        )}

        {/* Summary Footer */}
        {filteredMachines.length > 0 && (
          <div className="flex flex-col sm:flex-row justify-between items-center pt-4 border-t border-gray-100 gap-4">
            <div className="text-sm text-gray-500">
              Showing {filteredMachines.length} of {machines.length} machines
            </div>
            <Button
              variant="link"
              icon="mdi:export"
              onClick={() => Swal.fire({
                title: 'Export',
                text: 'Exporting machine data...',
                icon: 'info',
                confirmButtonColor: '#1f4390',
              })}
            >
              Export Data
            </Button>
          </div>
        )}
      </Card>

      {/* View Modal */}
      <Modal
        isOpen={isViewModalOpen}
        onClose={handleCloseModal}
        title="Machine Details"
        size="xl"
        footer={
          <div className="flex justify-end gap-3">
            <Button variant="outline" onClick={handleCloseModal}>
              Close
            </Button>
            <Button
              variant="primary"
              onClick={() => {
                if (selectedMachine) {
                  handleEdit(selectedMachine)
                }
              }}
              icon="mdi:pencil"
            >
              Edit Machine
            </Button>
          </div>
        }
      >
        {selectedMachine && (
          <div className="space-y-6">
            {/* Header */}
            <div className="flex items-start justify-between pb-4 border-b">
              <div className="flex items-center gap-4">
                <div className="bg-blue-100 p-3 rounded-xl">
                  <Icon icon="mdi:printer" className="w-8 h-8 text-blue-600" />
                </div>
                <div>
                  <h2 className="text-2xl font-bold text-gray-900">{selectedMachine.name_ma}</h2>
                  <p className="text-sm text-gray-500 mt-1">Machine ID: {selectedMachine.id_ma}</p>
                </div>
              </div>
              <Badge variant="success" size="lg">Active</Badge>
            </div>

            {/* Specifications */}
            <div className="grid md:grid-cols-2 gap-6">
              {/* Material Size */}
              <Card className="p-5 bg-blue-50 border-blue-200">
                <div className="flex items-center gap-2 mb-4">
                  <Icon icon="mdi:ruler-square" className="w-5 h-5 text-blue-600" />
                  <h3 className="font-semibold text-blue-900">Material Size Limits</h3>
                </div>
                <div className="space-y-3">
                  <div>
                    <p className="text-xs text-blue-700 mb-1">Maximum</p>
                    <p className="text-2xl font-bold text-blue-900">
                      {formatSize(selectedMachine.bahan_max_panjang, selectedMachine.bahan_max_lebar)}
                    </p>
                  </div>
                  <div className="border-t border-blue-200 pt-3">
                    <p className="text-xs text-blue-700 mb-1">Minimum</p>
                    <p className="text-lg font-semibold text-blue-800">
                      {formatSize(selectedMachine.bahan_min_panjang, selectedMachine.bahan_min_lebar)}
                    </p>
                  </div>
                </div>
              </Card>

              {/* Print Area */}
              <Card className="p-5 bg-green-50 border-green-200">
                <div className="flex items-center gap-2 mb-4">
                  <Icon icon="mdi:printer" className="w-5 h-5 text-green-600" />
                  <h3 className="font-semibold text-green-900">Print Area Limits</h3>
                </div>
                <div className="space-y-3">
                  <div>
                    <p className="text-xs text-green-700 mb-1">Maximum</p>
                    <p className="text-2xl font-bold text-green-900">
                      {formatSize(selectedMachine.cetak_max_panjang, selectedMachine.cetak_max_lebar)}
                    </p>
                  </div>
                  <div className="border-t border-green-200 pt-3">
                    <p className="text-xs text-green-700 mb-1">Minimum</p>
                    <p className="text-lg font-semibold text-green-800">
                      {formatSize(selectedMachine.cetak_min_panjang, selectedMachine.cetak_min_lebar)}
                    </p>
                  </div>
                </div>
              </Card>
            </div>

            {/* Pricing */}
            <div>
              <h3 className="font-semibold text-gray-900 mb-4 flex items-center gap-2">
                <Icon icon="mdi:cash-multiple" className="w-5 h-5 text-gray-600" />
                Print Types & Pricing
              </h3>
              <div className="grid gap-3">
                {printTypes.map((type) => (
                  <Card key={type.id} className="p-4 hover:shadow-md transition-shadow">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-3">
                        <div className="bg-gray-100 p-2 rounded-lg">
                          <Icon icon={type.icon} className="w-5 h-5 text-gray-600" />
                        </div>
                        <div>
                          <p className="font-medium text-gray-900">{type.label}</p>
                          <p className="text-xs text-gray-500">Price per sheet</p>
                        </div>
                      </div>
                      <p className="text-2xl font-bold text-green-600">
                        {formatCurrency(selectedMachine[type.field as keyof Machine])}
                      </p>
                    </div>
                  </Card>
                ))}
              </div>
            </div>
          </div>
        )}
      </Modal>

      {/* Edit Modal */}
      <Modal
        isOpen={isEditModalOpen}
        onClose={handleCloseModal}
        title={`Edit Machine - ${selectedMachine?.name_ma}`}
        size="xl"
        footer={
          <div className="flex justify-end gap-3">
            <Button
              variant="outline"
              onClick={handleCloseModal}
              disabled={posting}
            >
              Batal
            </Button>
            <Button
              variant="primary"
              onClick={() => {
                const form = document.forms.namedItem('editForm')
                if (form) {
                  const formData = {
                    maxMaterialWidth: parseFloat((form.elements.namedItem('maxMaterialWidth') as HTMLInputElement).value),
                    maxMaterialLength: parseFloat((form.elements.namedItem('maxMaterialLength') as HTMLInputElement).value),
                    minMaterialWidth: parseFloat((form.elements.namedItem('minMaterialWidth') as HTMLInputElement).value),
                    minMaterialLength: parseFloat((form.elements.namedItem('minMaterialLength') as HTMLInputElement).value),
                    maxPrintWidth: parseFloat((form.elements.namedItem('maxPrintWidth') as HTMLInputElement).value),
                    maxPrintLength: parseFloat((form.elements.namedItem('maxPrintLength') as HTMLInputElement).value),
                    minPrintWidth: parseFloat((form.elements.namedItem('minPrintWidth') as HTMLInputElement).value),
                    minPrintLength: parseFloat((form.elements.namedItem('minPrintLength') as HTMLInputElement).value),
                    priceBlok: parseFloat((form.elements.namedItem('priceBlok') as HTMLInputElement).value),
                    priceTulisan: parseFloat((form.elements.namedItem('priceTulisan') as HTMLInputElement).value),
                    priceSeparasi: parseFloat((form.elements.namedItem('priceSeparasi') as HTMLInputElement).value)
                  }
                  handleUpdate(formData)
                }
              }}
              loading={posting}
              disabled={posting}
            >
              {posting ? 'Menyimpan...' : 'Simpan Perubahan'}
            </Button>
          </div>
        }
      >
        {selectedMachine && (
          <form name="editForm" className="space-y-6">
            {/* Info Banner */}
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <div className="flex gap-3">
                <Icon icon="mdi:information" className="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" />
                <div>
                  <p className="text-sm font-medium text-blue-900">
                    Editing Machine: {selectedMachine.name_ma}
                  </p>
                  <p className="text-xs text-blue-700 mt-1">
                    Machine ID: {selectedMachine.id_ma} • Update all fields below
                  </p>
                </div>
              </div>
            </div>

            {/* Pricing */}
            <div className="space-y-4">
              <h3 className="font-semibold text-gray-900 flex items-center gap-2">
                <Icon icon="mdi:cash" className="w-5 h-5 text-amber-600" />
                Print Pricing (IDR)
              </h3>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                {printTypes.map((type) => (
                  <Input
                    key={type.id}
                    label={type.label}
                    name={`price${type.id.charAt(0).toUpperCase() + type.id.slice(1)}`}
                    type="number"
                    step="1000"
                    defaultValue={selectedMachine[type.field as keyof Machine]}
                    disabled={posting}
                  />
                ))}
              </div>
            </div>

            {/* Material Size */}
            <div className="space-y-4">
              <h3 className="font-semibold text-gray-900 flex items-center gap-2">
                <Icon icon="mdi:ruler-square" className="w-5 h-5 text-blue-600" />
                Material Size (cm)
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <Input
                  label="Max Width"
                  name="maxMaterialWidth"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.bahan_max_panjang}
                  disabled={posting}
                />
                <Input
                  label="Max Length"
                  name="maxMaterialLength"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.bahan_max_lebar}
                  disabled={posting}
                />
                <Input
                  label="Min Width"
                  name="minMaterialWidth"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.bahan_min_panjang}
                  disabled={posting}
                />
                <Input
                  label="Min Length"
                  name="minMaterialLength"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.bahan_min_lebar}
                  disabled={posting}
                />
              </div>
            </div>

            {/* Print Size */}
            <div className="space-y-4">
              <h3 className="font-semibold text-gray-900 flex items-center gap-2">
                <Icon icon="mdi:printer" className="w-5 h-5 text-green-600" />
                Print Area (cm)
              </h3>
              <div className="grid grid-cols-2 gap-4">
                <Input
                  label="Max Width"
                  name="maxPrintWidth"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.cetak_max_panjang}
                  disabled={posting}
                />
                <Input
                  label="Max Length"
                  name="maxPrintLength"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.cetak_max_lebar}
                  disabled={posting}
                />
                <Input
                  label="Min Width"
                  name="minPrintWidth"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.cetak_min_panjang}
                  disabled={posting}
                />
                <Input
                  label="Min Length"
                  name="minPrintLength"
                  type="number"
                  step="0.01"
                  defaultValue={selectedMachine.cetak_min_lebar}
                  disabled={posting}
                />
              </div>
            </div>
          </form>
        )}
      </Modal>
    </div>
  )
}